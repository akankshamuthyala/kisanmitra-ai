# Server
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (Replit Postgres provides DATABASE_URL automatically; local fallback uses PGlite if not provided)
DATABASE_URL=postgresql://app_user:password@localhost:5432/kisanmitra
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-64-char-random-string-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Gemini (server-side only; NEVER expose to the client)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# Limits
DEFAULT_DAILY_AI_QUOTA=20
MAX_UPLOAD_MB=5

# Client (Vite; only non-secret values)
VITE_API_BASE_URL=/api
VITE_DEFAULT_LANGUAGE=en
